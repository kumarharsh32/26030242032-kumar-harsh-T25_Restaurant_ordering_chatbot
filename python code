# ============================================================
# INTERACTIVE CHATBOT
# ============================================================

def chatbot():

    order = []

    allergies = []

    print("\n")
    print("==============================================")
    print("       TAMBA RASSA KITCHEN CHATBOT")
    print("==============================================")
    print("Type 'menu' to see the menu.")
    print("Type 'order' to see your order.")
    print("Type 'bill' to calculate your bill.")
    print("Type 'quit' to exit.")
    print("----------------------------------------------")

    # Ask allergies first
    allergy_input = input(
        "\nDo you have any food allergies? "
        "(e.g. dairy, gluten, nuts, or type 'no'): "
    )

    if allergy_input.lower().strip() != "no":

        allergies = [
            x.strip().lower()
            for x in allergy_input.split(",")
            if x.strip()
        ]

        print(
            f"Allergy restrictions recorded: "
            f"{allergies}"
        )

    while True:

        message = input("\nYou: ").strip()

        if not message:
            continue

        lower = message.lower()

        # ----------------------------------------------------
        # EXIT
        # ----------------------------------------------------

        if lower in ["quit", "exit", "bye"]:
            print("Bot: Thank you! Goodbye.")
            break

        # ----------------------------------------------------
        # MENU
        # ----------------------------------------------------

        if lower == "menu":
            show_menu()
            continue

        # ----------------------------------------------------
        # ORDER
        # ----------------------------------------------------

        if lower == "order":
            show_order(order)
            continue

        # ----------------------------------------------------
        # BILL
        # ----------------------------------------------------

        if lower == "bill":

            result = calculate_final_bill(
                order,
                weekday=False
            )

            print_bill(result)

            continue

        # ----------------------------------------------------
        # VEG STARTERS
        # ----------------------------------------------------

        if (
            "veg starters" in lower
            and (
                "not spicy" in lower
                or "non spicy" in lower
                or "mild" in lower
            )
        ):

            results = []

            for item in menu:

                if (
                    item["category"] == "Starters"
                    and is_veg(item)
                    and is_available(item)
                    and str(item["spice_level"]).lower()
                    in ["mild", "medium"]
                ):
                    results.append(item)

            print("\nBot:")

            if results:
                for item in results:
                    print(
                        f"• {item['item_name']} "
                        f"₹{item['price_inr']}"
                    )
            else:
                print(
                    "Sorry, no matching starters "
                    "are available."
                )

            continue

        # ----------------------------------------------------
        # JAIN
        # ----------------------------------------------------

        if "jain" in lower:

            results = find_jain_options()

            print("\nBot:")

            if results:

                for item in results:
                    print(
                        f"• {item['item_name']} "
                        "— Jain on request"
                    )

            else:
                print(
                    "There are no explicitly marked "
                    "Jain options available."
                )

            continue

        # ----------------------------------------------------
        # REMOVE ITEM
        # ----------------------------------------------------

        if (
            "remove" in lower
            or "delete" in lower
        ):

            # Try every menu item
            for item in menu:

                if item["item_name"].lower() in lower:

                    success, response = remove_item(
                        order,
                        item["item_name"]
                    )

                    print("Bot:", response)
                    break

            else:

                print(
                    "Bot: Please tell me which menu "
                    "item you want removed."
                )

            continue

        # ----------------------------------------------------
        # ADD ITEM
        # ----------------------------------------------------

        found_something = False

        for item in menu:

            item_name = item["item_name"]

            if item_name.lower() in lower:

                found_something = True

                # --------------------------------------------
                # Extract quantity
                # --------------------------------------------

                quantity = 1

                pattern = (
                    r"(\d+)\s+"
                    + re.escape(item_name.lower())
                )

                match = re.search(
                    pattern,
                    lower
                )

                if match:
                    quantity = int(match.group(1))

                success, response = add_item(
                    order,
                    item_name,
                    quantity,
                    allergies
                )

                print("Bot:", response)

                break

        if found_something:
            continue

        # ----------------------------------------------------
        # DELIVERY
        # ----------------------------------------------------

        if "delivery" in lower:

            print(
                "Bot: We deliver within a "
                "6 km radius."
            )

            print(
                "Free delivery is available "
                "for orders above ₹499."
            )

            print(
                "Otherwise, delivery charge is ₹40."
            )

            continue

        # ----------------------------------------------------
        # GST
        # ----------------------------------------------------

        if "gst" in lower:

            print(
                "Bot: GST is 5% on the food bill."
            )

            continue

        # ----------------------------------------------------
        # FALLBACK
        # ----------------------------------------------------

        print(
            "Bot: I couldn't confidently match that "
            "request to the restaurant menu. "
            "Please type 'menu' or specify the item name."
        )


