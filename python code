# ============================================================
# FIND VEG / NON-SPICY ITEMS
# ============================================================

def find_veg_non_spicy():

    results = []

    for item in menu:

        if not is_available(item):
            continue

        if not is_veg(item):
            continue

        spice = str(
            item["spice_level"]
        ).lower()

        if spice in ["mild", "-"]:

            results.append(item)

    return results


# ============================================================
# JAIN OPTIONS
# ============================================================

def find_jain_options():

    results = []

    for item in menu:

        if not is_available(item):
            continue

        food_type = str(
            item["food_type"]
        ).lower()

        # The dataset explicitly marks Sabudana Vada
        # as "Veg (Jain on request)"

        if "jain" in food_type:
            results.append(item)

    return results


