# ============================================================
# ALLERGEN CHECK
# ============================================================

def allergen_conflict(item, allergies):

    if not allergies:
        return False

    allergen_note = item.get("allergen_note")

    if not allergen_note:
        return False

    allergen_note = str(allergen_note).lower()

    for allergy in allergies:

        allergy = allergy.lower().strip()

        if allergy in allergen_note:
            return True

    return False


# ============================================================
# AVAILABILITY CHECK
# ============================================================

def is_available(item):

    return str(
        item.get("available_today", "")
    ).strip().lower() == "yes"


# ============================================================
# FOOD TYPE CHECK
# ============================================================

def is_veg(item):

    food_type = str(
        item.get("food_type", "")
    ).lower()

    return "veg" in food_type and "non-veg" not in food_type


# ============================================================
# BILL CALCULATION
# ============================================================

def calculate_bill(order):

    """
    order format:

    [
        {
            "item": menu_item,
            "quantity": 2
        }
    ]
    """

    subtotal = 0

    bill_lines = []

    for entry in order:

        item = entry["item"]
        quantity = entry["quantity"]

        amount = item["price_inr"] * quantity

        subtotal += amount

        bill_lines.append({
            "item_name": item["item_name"],
            "quantity": quantity,
            "unit_price": item["price_inr"],
            "amount": amount
        })

    # ========================================================
    # WEEKDAY OFFER
    # ========================================================
    #
    # We don't automatically apply this because the chatbot
    # needs to know the day.
    #
    # Use calculate_final_bill() when the day is known.
    # ========================================================

    return bill_lines, subtotal


# ============================================================
# FINAL BILL
# ============================================================

def calculate_final_bill(
    order,
    weekday=False,
    delivery_distance_km=None
):

    bill_lines, subtotal = calculate_bill(order)

    discount = 0

    # Restaurant Info:
    # "10% off on orders above Rs 999 on weekdays"

    if weekday and subtotal > 999:
        discount = subtotal * 0.10

    amount_after_discount = subtotal - discount

    # Restaurant Info:
    # "5% GST on food bill"

    gst = amount_after_discount * 0.05

    # Delivery charge
    delivery_charge = 0

    if delivery_distance_km is not None:

        if delivery_distance_km > 6:
            return {
                "success": False,
                "error": (
                    "Sorry, the delivery location is outside "
                    "our 6 km delivery radius."
                )
            }

        if subtotal <= 499:
            delivery_charge = 40

    grand_total = (
        amount_after_discount
        + gst
        + delivery_charge
    )

    return {
        "success": True,
        "bill_lines": bill_lines,
        "subtotal": round(subtotal, 2),
        "discount": round(discount, 2),
        "amount_after_discount": round(
            amount_after_discount, 2
        ),
        "gst": round(gst, 2),
        "delivery_charge": round(
            delivery_charge, 2
        ),
        "grand_total": round(
            grand_total, 2
        )
    }


# ============================================================
# PRINT BILL
# ============================================================

def print_bill(result):

    if not result["success"]:
        print("\n❌", result["error"])
        return

    print("\n===================================")
    print("        TAMBA RASSA KITCHEN")
    print("===================================")

    for line in result["bill_lines"]:

        print(
            f"{line['item_name']} x {line['quantity']} "
            f"@ ₹{line['unit_price']:.0f} "
            f"= ₹{line['amount']:.2f}"
        )

    print("-----------------------------------")

    print(f"Subtotal: ₹{result['subtotal']:.2f}")

    if result["discount"] > 0:
        print(
            f"Weekday Discount: "
            f"-₹{result['discount']:.2f}"
        )

    print(
        f"GST (5%): ₹{result['gst']:.2f}"
    )

    if result["delivery_charge"] > 0:
        print(
            f"Delivery: "
            f"₹{result['delivery_charge']:.2f}"
        )
    else:
        print("Delivery: FREE")

    print("-----------------------------------")

    print(
        f"TOTAL: ₹{result['grand_total']:.2f}"
    )

    print("===================================")


# ============================================================
# ADD ITEM TO ORDER
# ============================================================

def add_item(
    order,
    item_name,
    quantity=1,
    allergies=None
):

    if quantity <= 0:
        return False, "Quantity must be greater than zero."

    item = find_item(item_name)

    if item is None:
        return False, (
            f"Sorry, I could not find '{item_name}' "
            "on the menu."
        )

    # --------------------------------------------------------
    # AVAILABILITY RULE
    # --------------------------------------------------------

    if not is_available(item):

        return False, (
            f"❌ {item['item_name']} is currently "
            "unavailable today."
        )

    # --------------------------------------------------------
    # ALLERGEN RULE
    # --------------------------------------------------------

    if allergen_conflict(item, allergies):

        return False, (
            f"⚠️ {item['item_name']} cannot be added "
            f"because it has this allergen information: "
            f"{item['allergen_note']}."
        )

    # --------------------------------------------------------
    # ADD TO ORDER
    # --------------------------------------------------------

    for existing in order:

        if existing["item"]["item_id"] == item["item_id"]:

            existing["quantity"] += quantity

            return True, (
                f"Added {quantity} more "
                f"{item['item_name']}."
            )

    order.append({
        "item": item,
        "quantity": quantity
    })

    return True, (
        f"Added {quantity} x "
        f"{item['item_name']}."
    )


# ============================================================
# REMOVE ITEM
# ============================================================

def remove_item(order, item_name, quantity=None):

    item = find_item(item_name)

    if item is None:
        return False, (
            f"I couldn't find '{item_name}' "
            "on the menu."
        )

    for existing in order:

        if existing["item"]["item_id"] == item["item_id"]:

            if quantity is None:
                order.remove(existing)

                return True, (
                    f"Removed {item['item_name']} "
                    "from your order."
                )

            if quantity >= existing["quantity"]:

                order.remove(existing)

                return True, (
                    f"Removed {item['item_name']} "
                    "from your order."
                )

            existing["quantity"] -= quantity

            return True, (
                f"Removed {quantity} x "
                f"{item['item_name']}."
            )

    return False, (
        f"{item['item_name']} is not currently "
        "in your order."
    )


