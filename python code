# ============================================================
# READ MENU USING THE ACTUAL HEADERS
# ============================================================

menu_headers = [
    cell.value for cell in menu_ws[1]
]

menu = []

for row in menu_ws.iter_rows(min_row=2, values_only=True):

    # Ignore completely empty rows
    if not any(v is not None for v in row):
        continue

    item = dict(zip(menu_headers, row))

    # Convert values to predictable formats
    if item.get("price_inr") is not None:
        item["price_inr"] = float(item["price_inr"])

    if item.get("prep_time_min") is not None:
        item["prep_time_min"] = int(item["prep_time_min"])

    menu.append(item)


# ============================================================
# READ RESTAURANT INFO
# ============================================================

restaurant_info = {}

for row in info_ws.iter_rows(min_row=2, values_only=True):

    if row[0] is not None:
        restaurant_info[str(row[0]).strip()] = row[1]


# ============================================================
# BASIC VALIDATION
# ============================================================

REQUIRED_MENU_COLUMNS = [
    "item_id",
    "category",
    "item_name",
    "price_inr",
    "food_type",
    "spice_level",
    "prep_time_min",
    "allergen_note",
    "available_today"
]

missing_columns = [
    c for c in REQUIRED_MENU_COLUMNS
    if c not in menu_headers
]

if missing_columns:
    raise ValueError(
        f"Menu sheet is missing required columns: {missing_columns}"
    )

print(f"Loaded {len(menu)} menu items.")
print("Menu columns:", menu_headers)
print("Restaurant information loaded:", restaurant_info)


# ============================================================
# CREATE LOOKUP TABLES
# ============================================================

ITEM_BY_ID = {
    str(item["item_id"]).lower(): item
    for item in menu
}

ITEM_BY_NAME = {
    str(item["item_name"]).lower(): item
    for item in menu
}

ITEM_NAMES = list(ITEM_BY_NAME.keys())


# ============================================================
# FIND MENU ITEM
# ============================================================

def find_item(item_name):

    item_name = item_name.strip().lower()

    # Exact match
    if item_name in ITEM_BY_NAME:
        return ITEM_BY_NAME[item_name]

    # Exact ID
    if item_name in ITEM_BY_ID:
        return ITEM_BY_ID[item_name]

    # Partial matching
    for name, item in ITEM_BY_NAME.items():

        if item_name in name or name in item_name:
            return item

    # Fuzzy matching
    matches = get_close_matches(
        item_name,
        ITEM_NAMES,
        n=1,
        cutoff=0.65
    )

    if matches:
        return ITEM_BY_NAME[matches[0]]

    return None


# ============================================================
# DISPLAY MENU
# ============================================================

def show_menu():

    print("\n========== TAMBA RASSA KITCHEN MENU ==========\n")

    current_category = None

    for item in menu:

